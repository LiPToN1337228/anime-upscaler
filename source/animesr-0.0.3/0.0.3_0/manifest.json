         }
      },
      "02-animeSrOff": {
         "description": "__MSG_turn_off_anime_sr__",
         "suggested_key": {
            "default": "Alt+Shift+W"
         }
      },
      "03-triggleFpsWindow": {
         "description": "__MSG_fps_winodw__"
      },
      "04-reducePower": {
         "description": "__MSG_reduce_power__",
         "suggested_key": {
            "default": "Alt+Shift+1"
         }
      },
      "05-increasePower": {
         "description": "__MSG_increase_power__",
         "suggested_key": {
            "default": "Alt+Shift+2"
         }
      }
